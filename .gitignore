misc/
.vscode/
kemp-learner/
rsconnect/

# Exploratory analysis scripts stay local. The one file the manuscript
# sources at knit time is tracked (git does not descend into ignored dirs,
# so the directory itself is not listed here).
analysis/*
!analysis/permutation_test.R

# knitr / R Markdown caches and helper outputs
*_files
*.h
writeup/*.html
analysis/reliability_interpretation.pdf

