*.tex
*.log
*.aux
*.fff
*.ttt
*.toc
*.out
*.bbl
*.blg
*.synctex.gz
writeup/_render*.log

# knitr PNG outputs dropped in writeup/ root (canonical copies are in data/figures/)
writeup/*.png

# Duplicated knitr fig.path output inside writeup/
writeup/data/figures/

# Top-level figures/ directory (exploratory/scratch figures)
/figures/

# jsPsych library and images bundled with experiment files (see README for CDN instructions)
experiment files/jspsych/
experiment files/images/

# Project-specific large or sensitive directories
data/demographics/

# Third-party norm files (not redistributed; download sources documented in
